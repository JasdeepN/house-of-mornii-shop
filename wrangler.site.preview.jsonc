// Storefront (private preview, #62): the dev build, rebuilt against the
// production store, served at preview.houseofmornii.com behind Cloudflare Access.
// Deployed by .github/workflows/deploy-site.yml after a green dev run with:
//   npx wrangler deploy -c wrangler.site.preview.jsonc
// workers_dev and preview_urls are off: those hostnames would bypass Access.
// No /api/* Workers are routed here: no sign-in and no enquiries on the preview.
{
  "name": "preview-hom",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "preview.houseofmornii.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
