# Shopify Storefront API
# Copy this file to .env.local and replace with your actual credentials.
# Both are required: the app throws at startup when they are missing or placeholders.

VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-api-public-access-token

# SECURITY: The real Shopify Admin API token must NEVER be prefixed with VITE_
# (any VITE_-prefixed var is bundled into the client JS and is publicly readable).
# Set the actual token ONLY as a non-VITE server-side env var named
# SHOPIFY_ADMIN_ACCESS_TOKEN in the Cloudflare Worker / Pages project settings
# (workers/shopify-proxy.ts reads it from `env.SHOPIFY_ADMIN_ACCESS_TOKEN`).
# Do not add SHOPIFY_ADMIN_ACCESS_TOKEN to this file or any VITE_ client env file.
#
# --- Cloudflare Worker (Shopify Automation Worker) — server-side only ---
# The Worker at workers/shopify-proxy.ts is deployed via wrangler.toml (see
# repo root). It is NOT configured through this .env file — its secrets and
# vars live in Cloudflare (Worker settings / `wrangler secret put`), never in
# any VITE_-prefixed client env var. Documented here for reference only:
#
#   Secrets (set via `wrangler secret put <NAME>`, never committed):
#     SHOPIFY_ADMIN_ACCESS_TOKEN — Admin API access token (server-side only)
#     SHOPIFY_WEBHOOK_SECRET     — shared secret for verifying Shopify webhook HMACs
#
#   Vars (set in wrangler.toml [vars], non-secret):
#     SHOPIFY_STORE_DOMAIN — same store domain as VITE_SHOPIFY_STORE_DOMAIN
#
#   Bindings (declared in wrangler.toml, provisioned in Cloudflare dashboard):
#     SHOPIFY_BACKUPS (R2 bucket)    — daily backup JSON snapshots (products/collections/orders)
#     BACKUP_INDEX (KV namespace)    — `latest-backup` key with { date, keys, counts, completedAt }
#
# See docs/deployment-runbook.md for the full secrets-provisioning and
# webhook-registration runbook.
#
# --- Dev environment: isolated store + nightly Catalog Sync Worker ---
# dev.houseofmornii.com uses its OWN free Shopify development store (Approach
# A — see docs/dev-snapshot-environment-plan.md), never the live production
# store. This app's own VITE_ vars point at that dev store like any other env:
#
#   VITE_SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
#   VITE_SHOPIFY_STOREFRONT_TOKEN=dev-storefront-token
#
# A separate Cloudflare Worker (workers/catalog-sync.ts, deployed via
# wrangler.catalog-sync.toml — NOT this .env file) copies CATALOG DATA ONLY
# (products + collections; never orders/customers/PII) from production into
# this dev store nightly. Its credentials are documented here for reference
# only — they are provisioned via `wrangler secret put` / vars in
# wrangler.catalog-sync.toml, never as VITE_-prefixed vars, and never
# committed:
#
#   Secrets (set via `wrangler secret put <NAME> --config wrangler.catalog-sync.toml`):
#     PROD_ADMIN_ACCESS_TOKEN — read-only Admin API token for the PRODUCTION store (source)
#     DEV_ADMIN_ACCESS_TOKEN  — read+write Admin API token for the DEV store (destination)
#
#   Vars (set in wrangler.catalog-sync.toml [vars], non-secret):
#     PROD_SHOPIFY_STORE_DOMAIN — production store domain (read-only source)
#     DEV_SHOPIFY_STORE_DOMAIN  — dev store domain (write destination)
#
# See docs/deployment-environments-setup.md ("Dev Is an Isolated,
# Nightly-Synced Store") for full setup + `wrangler tail` observability steps.

# Public site configuration
# Dev/prototype builds can keep placeholder values here. Production should use
# GitHub Actions variables or Cloudflare Pages environment variables for final copy.
VITE_SITE_NAME=House of Mornii
VITE_SITE_TITLE=House of Mornii Preview
VITE_SITE_DESCRIPTION=Regal costume jewellery showcase in development. Final product, policy, contact, and marketing integrations are configured by environment.
VITE_SITE_URL=http://localhost:5173
VITE_SITE_OG_IMAGE_PATH=/og-image.png
VITE_SITE_OG_IMAGE_ALT=House of Mornii preview image
VITE_THEME_COLOR=oklch(0.336 0.054 200.5)

# Public contact placeholders
# Leave blank until business-owned contact details are ready.
VITE_CONTACT_EMAIL=
VITE_INSTAGRAM_HANDLE=@houseofmornii
VITE_INSTAGRAM_URL=https://instagram.com/houseofmornii
VITE_CONTACT_LOCATION_LABEL=Appointment details coming soon

# Provider-neutral newsletter hook
# Leave blank for prototype/demo mode. Set to a relative or absolute endpoint
# when the final email platform/API is ready.
VITE_NEWSLETTER_ENDPOINT=
VITE_NEWSLETTER_EYEBROW=Join the House of Mornii list
VITE_NEWSLETTER_PLACEHOLDER=your@email.com
VITE_NEWSLETTER_CTA=Join
VITE_NEWSLETTER_LOADING_LABEL=Joining...
VITE_NEWSLETTER_SUCCESS_MESSAGE=Thank you. We will share updates as the collection opens.
VITE_NEWSLETTER_ERROR_MESSAGE=We could not save your email yet. Please try again.
VITE_WELCOME_POPUP_EYEBROW=Welcome
VITE_WELCOME_POPUP_TITLE=House of Mornii Preview
VITE_WELCOME_POPUP_DESCRIPTION=Join the list for collection previews and launch updates.
# The popup stays off unless this is "true"; turn it on once sign-ups reach Shopify (#34).
VITE_WELCOME_POPUP_ENABLED=

# Analytics (optional — omit to disable tracking)
# GA4 measurement ID from Google Analytics 4 (Settings → Data Streams → Measurement ID)
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel ID from Events Manager → Data Sources (numeric, e.g. 1234567890)
VITE_META_PIXEL_ID=
