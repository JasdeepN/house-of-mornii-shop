# Shopify Storefront API
export VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
export VITE_SHOPIFY_STOREFRONT_TOKEN=your-storefront-api-public-access-token

# Cloudflare Pages Deploy
export CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
export CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Analytics (optional)
export VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
export VITE_META_PIXEL_ID=1234567890

# GitHub Token (required for actions/checkout to work properly)
export GITHUB_TOKEN=ghp_your_personal_access_token_here
